{
  "build": {
    "install": [
      "mkdir -p /root/.local/bin",
      "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /root/.local/bin/yt-dlp",
      "chmod a+rx /root/.local/bin/yt-dlp",
      "curl -L https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ffmpeg.tar.xz",
      "tar -xJf /tmp/ffmpeg.tar.xz -C /tmp",
      "cp /tmp/ffmpeg-*-amd64-static/ffmpeg /root/.local/bin/ffmpeg",
      "cp /tmp/ffmpeg-*-amd64-static/ffprobe /root/.local/bin/ffprobe",
      "chmod a+rx /root/.local/bin/ffmpeg /root/.local/bin/ffprobe",
      "curl -fsSL https://bun.sh/install | bash"
    ],
    "postinstall": [],
    "env": {
      "PATH": "/root/.local/bin:/root/.bun/bin:${PATH}",
      "YTDLP_PATH": "/root/.local/bin/yt-dlp",
      "FFMPEG_PATH": "/root/.local/bin/ffmpeg"
    }
  },
  "start": {
    "cmd": "bun run src/index.ts"
  }
}
